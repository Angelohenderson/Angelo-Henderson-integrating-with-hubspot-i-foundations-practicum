html
  head
    title = title
  body
    h1= title
    form(action='/update-cobj', method='POST')
      label(for='name') Name
      input#name(type='text', name='name', required)
      br
      label(for='country') Country
      input#country(type='text', name='country', required)
      br
      label(for='fastest_model') Fastest Model
      input#fastest_model(type='text', name='name', required)
      br
      label(for='top_speed_mph) Top Speed (mph)
      input#top_speed_mph(type='number', name='top_speed_mph', min='0', required)
      br
      button(type='submit') Create Car Brand
    a(href='/') Return home
